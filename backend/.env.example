# Google Gemini API Configuration
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Model selection
GEMINI_MODEL=gemini-3-flash-preview

# Google Drive knowledge base (RAG)
# Option A (recommended): set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file path
# and share the Drive folder with that service-account email.
#
# Option B: use Application Default Credentials (gcloud auth application-default login)
#
# Provide either a folder ID (preferred) or a share link containing /folders/<id>
DRIVE_FOLDER=YOUR_DRIVE_FOLDER_ID_OR_LINK_HERE
DRIVE_SYNC_INTERVAL_MINUTES=30
RAG_TOP_K=5

# Server port
PORT=3001
